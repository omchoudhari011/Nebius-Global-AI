{
  "expo": {
    "name": "Custodian",
    "slug": "custodian",
    "scheme": "custodian",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "io.github.omchoudhari011.custodian",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "io.github.omchoudhari011.custodian",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5b4fc4"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Custodian",
      "shortName": "Custodian",
      "themeColor": "#5b4fc4",
      "backgroundColor": "#eef0f3",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store"
    ]
  }
}
