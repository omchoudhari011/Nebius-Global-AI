# Copy to backend/.env, or generate one with fresh secrets:
#   python -m app.cli init-env            (development)
#   python -m app.cli init-env --production
#
# In development, missing secrets are generated into DATA_DIR/.dev-secrets.json and the
# passcode is printed at startup. Production refuses to start without them.

CUSTODIAN_ENV=development

# --- Sign-in -----------------------------------------------------------------------
# The app's single-user passcode (at least 10 characters in production).
CUSTODIAN_PASSCODE=
CUSTODIAN_USER_EMAIL=owner@custodian.local
SESSION_SECRET=
SESSION_MAX_AGE_DAYS=30

# --- Encryption --------------------------------------------------------------------
# Fernet key(s) for messages, tool arguments/results and memories:
#   python -m app.cli gen-key
# Rotation: "new_key,old_key", then `python -m app.cli rotate-keys`, then drop old_key.
# Back this key up - without it the stored text can't be read.
APP_SECRET_KEY=

# --- Model -------------------------------------------------------------------------
# stub   = offline, deterministic, no key (good for development and tests)
# nebius = Nebius Token Factory serving NVIDIA Nemotron (OpenAI-compatible API)
MODEL_BACKEND=stub
NEBIUS_API_KEY=
NEBIUS_MODEL_ID=nvidia/nemotron-3-super-120b-a12b
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_TOKENS=1024
MODEL_TEMPERATURE=0.3
# Optional JSON merged into every request, for model-specific switches, e.g.
# MODEL_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
MODEL_EXTRA_BODY=

# --- Semantic search (optional) ------------------------------------------------------
# An embedding model adds meaning-based search to the keyword search over memories and
# past chats, so "brolly" finds "umbrella". Empty = keyword search only. Any
# OpenAI-compatible /embeddings endpoint works; it defaults to NEBIUS_BASE_URL and
# NEBIUS_API_KEY (the Nebius key is never sent to any other EMBEDDING_BASE_URL; set
# EMBEDDING_API_KEY for a different provider). Local Ollama: `ollama pull nomic-embed-text`, then
#   EMBEDDING_MODEL=nomic-embed-text
#   EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1   (127.0.0.1, not localhost: on Windows
#   "localhost" tries IPv6 first and each new connection to Ollama waits ~2 s)
# With a cloud endpoint, every memory and message you write is sent there once to be
# embedded (anything that looks like a secret excepted).
EMBEDDING_MODEL=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# Least cosine similarity for a semantic match (it must also stand out from the rest);
# 0.5 suits nomic-embed-text.
# EMBEDDING_MIN_SIMILARITY=0.5

# --- Where things live -------------------------------------------------------------
# DATA_DIR holds custodian.db, the tools' own data (DATA_DIR/tools) and dev secrets.
DATA_DIR=data
# DATABASE_PATH=data/custodian.db
# Your IANA time zone: calendar times and the default for scheduled tasks.
CUSTODIAN_TIMEZONE=UTC

# --- Web / network -----------------------------------------------------------------
# Origins allowed to call the API with credentials (comma-separated, never *).
# The Expo dev web server runs on 8081. Not needed when this server serves the web app.
CORS_ORIGINS=http://localhost:8081
# Defaults: secure cookies in production. Use none (+ secure) only if the web app is
# hosted on a different site than the API.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# Exported web app to serve at / (the Docker image sets this for you).
# WEB_DIST_DIR=../mobile/dist

# --- Runtime -----------------------------------------------------------------------
TOOL_TIMEOUT_SECONDS=5
SCHEDULER_ENABLED=true
LOG_LEVEL=INFO

# --- Plan and usage (see "Plans and licensing" in the README) ----------------------------
# A Pro or Cloud license key (CL1....). Without one, production runs the Free plan; a key
# pasted into the app's Account tab works too. Keys are checked offline.
# CUSTODIAN_LICENSE_KEY=
# Development only: preview a plan without a license (free, pro or cloud; default pro).
# CUSTODIAN_PLAN=free
# Where the Account tab's "Get a license" button goes (your store, see store/README.md).
# CUSTODIAN_PURCHASE_URL=https://store.example.com
# Model prices in USD per million tokens, for cost estimates on the Account tab. Unset means
# unknown, and no cost is shown. Use your provider's current prices.
# MODEL_PRICE_INPUT_PER_M=
# MODEL_PRICE_OUTPUT_PER_M=
