# Copy to backend/.env, or generate one with fresh secrets:
#   python -m app.cli init-env            (development)
#   python -m app.cli init-env --production
#
# In development, missing secrets are generated into DATA_DIR/.dev-secrets.json and the
# passcode is printed at startup. Production refuses to start without them.

CUSTODIAN_ENV=development

# --- Sign-in -----------------------------------------------------------------------
# The app's single-user passcode (at least 10 characters in production).
CUSTODIAN_PASSCODE=
CUSTODIAN_USER_EMAIL=owner@custodian.local
SESSION_SECRET=
SESSION_MAX_AGE_DAYS=30

# --- Encryption --------------------------------------------------------------------
# Fernet key(s) for messages, tool arguments/results and memories:
#   python -m app.cli gen-key
# Rotation: "new_key,old_key", then `python -m app.cli rotate-keys`, then drop old_key.
# Back this key up - without it the stored text can't be read.
APP_SECRET_KEY=

# --- Model -------------------------------------------------------------------------
# stub   = offline, deterministic, no key (good for development and tests)
# nebius = Nebius Token Factory serving NVIDIA Nemotron (OpenAI-compatible API)
MODEL_BACKEND=stub
NEBIUS_API_KEY=
NEBIUS_MODEL_ID=nvidia/nemotron-3-super-120b-a12b
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_TOKENS=2048
MODEL_TEMPERATURE=0.3
# Optional JSON merged into every request, for model-specific switches, e.g.
# MODEL_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
MODEL_EXTRA_BODY=

# --- Semantic search (optional) ------------------------------------------------------
# An embedding model adds meaning-based search to the keyword search over memories and
# past chats, so "brolly" finds "umbrella". Empty = keyword search only. Any
# OpenAI-compatible /embeddings endpoint works; it defaults to NEBIUS_BASE_URL and
# NEBIUS_API_KEY (the Nebius key is never sent to any other EMBEDDING_BASE_URL; set
# EMBEDDING_API_KEY for a different provider). Local Ollama: `ollama pull nomic-embed-text`, then
#   EMBEDDING_MODEL=nomic-embed-text
#   EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1   (127.0.0.1, not localhost: on Windows
#   "localhost" tries IPv6 first and each new connection to Ollama waits ~2 s)
# With a cloud endpoint, every memory and message you write is sent there once to be
# embedded (anything that looks like a secret excepted).
EMBEDDING_MODEL=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# Least cosine similarity for a semantic match (it must also stand out from the rest);
# 0.5 suits nomic-embed-text.
# EMBEDDING_MIN_SIMILARITY=0.5

# --- Where things live -------------------------------------------------------------
# DATA_DIR holds custodian.db, the tools' own data (DATA_DIR/tools) and dev secrets.
DATA_DIR=data
# DATABASE_PATH=data/custodian.db
# Your IANA time zone: calendar times and the default for scheduled tasks.
CUSTODIAN_TIMEZONE=UTC

# --- Web / network -----------------------------------------------------------------
# Origins allowed to call the API with credentials (comma-separated, never *).
# The Expo dev web server runs on 8081. Not needed when this server serves the web app.
CORS_ORIGINS=http://localhost:8081
# Defaults: secure cookies in production. Use none (+ secure) only if the web app is
# hosted on a different site than the API.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# Exported web app to serve at / (the Docker image sets this for you).
# WEB_DIST_DIR=../mobile/dist

# --- Runtime -----------------------------------------------------------------------
TOOL_TIMEOUT_SECONDS=5
SCHEDULER_ENABLED=true
LOG_LEVEL=INFO

# --- Plan and usage (see "Plans and licensing" in the README) ----------------------------
# A Pro or Cloud license key (CL1....). Without one, production runs the Free plan; a key
# pasted into the app's Account tab works too. Keys are checked offline.
# CUSTODIAN_LICENSE_KEY=
# Development only: preview a plan without a license (free, pro or cloud; default pro).
# CUSTODIAN_PLAN=free
# Where the Account tab's "Get a license" button goes (your store, see store/README.md).
# CUSTODIAN_PURCHASE_URL=https://store.example.com
# Model prices in USD per million tokens, for cost estimates on the Account tab. Unset means
# unknown, and no cost is shown. Use your provider's current prices.
# MODEL_PRICE_INPUT_PER_M=
# MODEL_PRICE_OUTPUT_PER_M=

# --- Everyday features (see "Everyday features" in the README) ------------------------------
# Reminders on your phone through ntfy (https://ntfy.sh): a long random topic, or your own
# ntfy server. Pushes say only "Reminder from Custodian" unless NTFY_SHOW_TEXT=true.
# NTFY_URL=https://ntfy.sh/replace-with-a-long-random-topic
# NTFY_SHOW_TEXT=false
# Voice messages: "local" runs Whisper in this server (pip install -r requirements-voice.txt;
# large-v3-turbo on an NVIDIA card, small on the processor), or an OpenAI-compatible
# speech-to-text server, e.g. the hwdsl2/whisper-server container (port 9000), which prints its
# API key on first start.
# WHISPER_URL=local
# WHISPER_LOCAL_MODEL=large-v3-turbo
# WHISPER_DEVICE=auto
# WHISPER_IDLE_MINUTES=10
# WHISPER_URL=http://127.0.0.1:9000/v1
# WHISPER_API_KEY=
# Photos: a vision model that describes them and reads their text (qwen3-vl:4b in Ollama here;
# a local one is let go VISION_KEEP_ALIVE after each use).
# VISION_MODEL=qwen3-vl:4b
# VISION_KEEP_ALIVE=2m
# VISION_BASE_URL=http://127.0.0.1:11434/v1
# VISION_API_KEY=
# Google Calendar, Gmail and Drive: your own OAuth client ("Web application") from
# console.cloud.google.com, with GOOGLE_REDIRECT_URI as an authorised redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/google/callback

# Seeing the screen ("what's on my screen?", "click the blue Sign in button"): a vision model that
# can point at things. Defaults to VISION_MODEL; a local one keeps screenshots on your network.
# SCREEN_VISION_MODEL=qwen2.5vl:7b

# Spotify: exact songs and playlists on any device (developer.spotify.com/dashboard; redirect URI below).
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://localhost:8000/integrations/spotify/callback

# Microsoft 365 (Outlook mail and calendar): an app registration at entra.microsoft.com, "Web"
# platform with the redirect URI below, delegated Mail.Read, Calendars.ReadWrite, User.Read, offline_access.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=http://localhost:8000/integrations/microsoft/callback

# Telegram: a bot of your own from @BotFather; link your chat in the app's Jarvis tab.
# TELEGRAM_BOT_TOKEN=
# "Think harder": a larger model for hard questions and for replies the everyday model gets
# wrong twice. Defaults to Nebius Token Factory with NEBIUS_API_KEY.
# LARGE_MODEL_ID=nvidia/nemotron-3-super-120b-a12b
# LARGE_MODEL_BASE_URL=https://api.tokenfactory.nebius.com/v1
# LARGE_MODEL_API_KEY=
# Backups: one encrypted file with everything, every day (app/backup.py). Another drive or a
# synced folder is best; keep a copy of APP_SECRET_KEY away from this PC - without it no backup
# can be restored.
# BACKUP_DIR=D:/Custodian backups
# BACKUP_TIME=03:30
# BACKUP_KEEP=14
